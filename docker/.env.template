# Example .env file for docker-compose
# Copy this file to .env and fill in your values
# Then uncomment the lines in docker-compose.yml to use these environment variables

# .NET Environment
DOTNET_ENVIRONMENT=Production

# Event Hub Configuration
EventHub__ServiceBusEndpoint=your-eventhub-namespace.servicebus.windows.net
EventHub__Name=your-eventhub-name

# Azure Identity Configuration (Optional - use for service principal authentication)
# Identity__TenantId=00000000-0000-0000-0000-000000000000
# Identity__AppId=00000000-0000-0000-0000-000000000000
# Identity__AppSecret=your-app-secret

# Worker Configuration (Optional)
# Worker__NumberOfMessages=100
# Worker__DelayBetweenMessages=00:00:01
